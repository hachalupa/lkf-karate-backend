{
  "kind": "collectionType",
  "collectionName": "up_users",
  "info": {
    "name": "user",
    "description": "",
    "singularName": "user",
    "pluralName": "users",
    "displayName": "User"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "username": {
      "type": "string",
      "minLength": 3,
      "unique": true,
      "configurable": false,
      "required": true
    },
    "email": {
      "type": "email",
      "minLength": 6,
      "configurable": false,
      "required": true
    },
    "provider": {
      "type": "string",
      "configurable": false
    },
    "password": {
      "type": "password",
      "minLength": 6,
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "resetPasswordToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmationToken": {
      "type": "string",
      "configurable": false,
      "private": true,
      "searchable": false
    },
    "confirmed": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "blocked": {
      "type": "boolean",
      "default": false,
      "configurable": false
    },
    "role": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.role",
      "inversedBy": "users",
      "configurable": false
    },
    "exam_attempts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::exam-attempt.exam-attempt",
      "mappedBy": "user"
    },
    "isAdmin": {
      "type": "boolean"
    },
    "firstName": {
      "type": "string"
    },
    "lastName": {
      "type": "string"
    },
    "verification": {
      "type": "enumeration",
      "enum": [
        "pending",
        "approved",
        "rejected"
      ]
    },
    "rejectionReason": {
      "type": "text"
    },
    "chapter_progresses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::chapter-progress.chapter-progress",
      "mappedBy": "users_permissions_user"
    },
    "profilePicture": {
      "type": "media",
      "multiple": false,
      "allowedTypes": [
        "images"
      ]
    },
    "country": {
      "type": "enumeration",
      "enum": [
        "Latvia"
      ]
    },
    "phoneNumber": {
      "type": "string"
    },
    "birthday": {
      "type": "date"
    },
    "rank": {
      "type": "string"
    },
    "language": {
      "type": "enumeration",
      "enum": [
        "lv",
        "ru",
        "en"
      ]
    },
    "themePreference": {
      "type": "enumeration",
      "enum": [
        "light",
        "dark",
        "system"
      ]
    },
    "clubName": {
      "type": "enumeration",
      "enum": [
        "Leonīda Vasiļjeva Karatē skola",
        "Latvijas Godžju-rju Karatē Federācija",
        "Fudzi Sporta Klubs",
        "Salaspils Karatē Klubs",
        "Tan",
        "Rīgas Karatē Klubs",
        "Ippon.lv",
        "Bolderājas Karatē klubs",
        "Daugavpils karatē skola",
        "Sochin Karate Klub",
        "Ruslana Sadikova sporta skola"
      ]
    }
  }
}
