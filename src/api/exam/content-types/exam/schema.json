{
  "kind": "collectionType",
  "collectionName": "exams",
  "info": {
    "singularName": "exam",
    "pluralName": "exams",
    "displayName": "Exam"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "title": {
      "type": "string"
    },
    "duration": {
      "type": "integer"
    },
    "questionCount": {
      "type": "integer"
    },
    "passingScore": {
      "type": "integer"
    },
    "openAt": {
      "type": "datetime"
    },
    "closeAt": {
      "type": "datetime"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "exams"
    },
    "exam_attempts": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::exam-attempt.exam-attempt",
      "mappedBy": "exam"
    },
    "showResults": {
      "type": "boolean"
    },
    "reviewType": {
      "type": "string",
      "description": "Set to 'import_review' for answer-key review exams created after a question import. They group imported questions that still need a correct answer, are hidden from students, and are never scored."
    },
    "questions": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::question.question",
      "inversedBy": "exams"
    },
    "questionDecisions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::exam-question-decision.exam-question-decision",
      "mappedBy": "exam"
    }
  }
}
