{
  "kind": "collectionType",
  "collectionName": "chapters",
  "info": {
    "singularName": "chapter",
    "pluralName": "chapters",
    "displayName": "Chapter"
  },
  "options": {
    "draftAndPublish": true
  },
  "pluginOptions": {},
  "attributes": {
    "titleLv": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "videoUrl": {
      "type": "string"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "chapters"
    },
    "questions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::question.question",
      "mappedBy": "chapter"
    },
    "chapter_progresses": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::chapter-progress.chapter-progress",
      "mappedBy": "chapter"
    },
    "media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "blocksLv": {
      "type": "json"
    },
    "titleRu": {
      "type": "string"
    },
    "titleEn": {
      "type": "string"
    },
    "blocksEn": {
      "type": "json"
    },
    "blocksRu": {
      "type": "json"
    },
    "baseLanguage": {
      "type": "enumeration",
      "enum": [
        "ru",
        "lv",
        "en"
      ]
    },
    "sourceMode": {
      "type": "enumeration",
      "enum": [
        "manual",
        "pdf"
      ]
    },
    "chapterKey": {
      "type": "string"
    },
    "sourceFile": {
      "type": "string"
    },
    "sourceVersion": {
      "type": "string"
    },
    "sourceLanguage": {
      "type": "enumeration",
      "enum": [
        "En",
        "Lv",
        "Ru"
      ]
    },
    "contentHash": {
      "type": "text"
    },
    "sourcePageFrom": {
      "type": "integer"
    },
    "sourcePageTo": {
      "type": "integer"
    }
  }
}
