{
  "kind": "collectionType",
  "collectionName": "questions",
  "info": {
    "singularName": "question",
    "pluralName": "questions",
    "displayName": "Question"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "textLv": {
      "type": "text"
    },
    "type": {
      "type": "enumeration",
      "enum": [
        "multiple_choice",
        "yes_no",
        "open_text",
        "single_choice",
        "aka_ao"
      ]
    },
    "optionsLv": {
      "type": "json"
    },
    "correctAnswer": {
      "type": "string"
    },
    "correctAnswers": {
      "type": "json"
    },
    "videoAkaUrl": {
      "type": "string"
    },
    "videoAoUrl": {
      "type": "string"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "questions"
    },
    "chapter": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::chapter.chapter",
      "inversedBy": "questions"
    },
    "media": {
      "type": "media",
      "multiple": true,
      "allowedTypes": [
        "images",
        "videos"
      ]
    },
    "exams": {
      "type": "relation",
      "relation": "manyToMany",
      "target": "api::exam.exam",
      "mappedBy": "questions"
    },
    "textRu": {
      "type": "text"
    },
    "textEn": {
      "type": "text"
    },
    "sourceLang": {
      "type": "string"
    },
    "sourceFile": {
      "type": "string"
    },
    "order": {
      "type": "integer"
    },
    "showInChapter": {
      "type": "boolean"
    },
    "optionsRu": {
      "type": "json"
    },
    "optionsEn": {
      "type": "json"
    },
    "answerFieldsLv": {
      "type": "json",
      "description": "Open-text answer fields (Latvian example answers). Array of { expected } — one entry per answer field. Judge-only reference text; no correct/incorrect flag is stored. The array length is the number of answer fields students see."
    },
    "answerFieldsRu": {
      "type": "json",
      "description": "Open-text answer fields (Russian example answers). Array of { expected } — must stay in sync with answerFieldsLv/En."
    },
    "answerFieldsEn": {
      "type": "json",
      "description": "Open-text answer fields (English example answers). Array of { expected } — must stay in sync with answerFieldsLv/Ru."
    },
    "sourceMode": {
      "type": "enumeration",
      "enum": [
        "manual",
        "pdf"
      ]
    },
    "sourceDocumentKey": {
      "type": "string"
    },
    "answerStatus": {
      "type": "enumeration",
      "enum": [
        "answered",
        "missing",
        "fromWord",
        "fromQuiz"
      ]
    },
    "questionSetKey": {
      "type": "string"
    },
    "sourceYear": {
      "type": "integer"
    },
    "sourceCategory": {
      "type": "string"
    },
    "sourceFiles": {
      "type": "json"
    },
    "textHashEn": {
      "type": "string"
    },
    "textHashLv": {
      "type": "string"
    },
    "textHashRu": {
      "type": "string"
    },
    "examDecisions": {
      "type": "relation",
      "relation": "oneToMany",
      "target": "api::exam-question-decision.exam-question-decision",
      "mappedBy": "question"
    }
  }
}
