{
  "kind": "collectionType",
  "collectionName": "grading_audit_logs",
  "info": {
    "singularName": "grading-audit-log",
    "pluralName": "grading-audit-logs",
    "displayName": "Grading Audit Log"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "oldDecision": {
      "type": "string",
      "description": "Answer-bank decision before the change: 'correct' | 'incorrect'"
    },
    "newDecision": {
      "type": "string",
      "description": "Answer-bank decision after the change: 'correct' | 'incorrect'"
    },
    "fieldIndex": {
      "type": "integer",
      "description": "0-based index of the answer field whose decision changed"
    },
    "recalculatedAttempts": {
      "type": "json",
      "description": "Snapshot of recalculated attempts: [{ attemptId, previousScore, newScore }]"
    },
    "admin": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user"
    },
    "exam": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::exam.exam"
    },
    "question": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::question.question"
    }
  }
}