{
  "kind": "collectionType",
  "collectionName": "exam_attempts",
  "info": {
    "singularName": "exam-attempt",
    "pluralName": "exam-attempts",
    "displayName": "ExamAttempt"
  },
  "options": {
    "draftAndPublish": false
  },
  "pluginOptions": {},
  "attributes": {
    "score": {
      "type": "integer"
    },
    "passed": {
      "type": "boolean"
    },
    "startedAt": {
      "type": "datetime"
    },
    "submittedAt": {
      "type": "datetime"
    },
    "answers": {
      "type": "json"
    },
    "questions": {
      "type": "json"
    },
    "manualGrades": {
      "type": "json",
      "description": "Per-question manual grades for open-text answers, keyed by question id: 1 = correct, 0 = incorrect"
    },
    "kind": {
      "type": "string",
      "description": "Snapshot of what this attempt is: 'exam' or 'quick_quiz'. Stored at creation so results survive course/exam deletion."
    },
    "exam": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::exam.exam",
      "inversedBy": "exam_attempts"
    },
    "user": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "plugin::users-permissions.user",
      "inversedBy": "exam_attempts"
    },
    "timeSpentSeconds": {
      "type": "integer"
    },
    "course": {
      "type": "relation",
      "relation": "manyToOne",
      "target": "api::course.course",
      "inversedBy": "exam_attempts"
    },
    "blurEventCount": {
      "type": "integer",
      "default": 0
    },
    "totalTimeOutsideSeconds": {
      "type": "integer",
      "default": 0
    },
    "lastVisibilityState": {
      "type": "string"
    },
    "lastKnownPage": {
      "type": "string"
    },
    "lastActivityAt": {
      "type": "datetime"
    }
  }
}
