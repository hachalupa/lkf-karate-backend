# ─── Strapi Backend Environment Variables ─────────────────────────────────────
# Copy this file to .env and fill in your values.
#   cp .env.example .env

# ─── Server ───────────────────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=1337

# Generate via: openssl rand -base64 32 (repeat 4 times, comma-separated)
APP_KEYS=

# ─── Admin Panel ──────────────────────────────────────────────────────────────
# Generate via: openssl rand -base64 32
ADMIN_JWT_SECRET=
API_TOKEN_SALT=
TRANSFER_TOKEN_SALT=
ENCRYPTION_KEY=

# ─── Database (default: SQLite) ───────────────────────────────────────────────
# Change to "postgres" or "mysql" for production deployments.
# When using sqlite, only DATABASE_FILENAME is needed.
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=.tmp/data.db

# For PostgreSQL:
# DATABASE_CLIENT=postgres
# DATABASE_HOST=localhost
# DATABASE_PORT=5432
# DATABASE_NAME=lkf_karate
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false
# DATABASE_URL=postgres://user:password@localhost:5432/lkf_karate

# For MySQL:
# DATABASE_CLIENT=mysql
# DATABASE_HOST=localhost
# DATABASE_PORT=3306
# DATABASE_NAME=lkf_karate
# DATABASE_USERNAME=strapi
# DATABASE_PASSWORD=strapi
# DATABASE_SSL=false

# ─── Email (Nodemailer via Gmail SMTP) ────────────────────────────────────────
# Required for password reset flow (forgot-password / reset-password).
GMAIL_USER=
GMAIL_PASS=

# ─── Webhooks ─────────────────────────────────────────────────────────────────
WEBHOOKS_POPULATE_RELATIONS=false

# ─── Frontend URL (for reset password links in emails) ───────────────────────
FRONTEND_URL=http://localhost:5173
